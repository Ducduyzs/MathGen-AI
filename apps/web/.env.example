# Bật mock API trong Next.js (chỉ dùng khi chưa có backend FastAPI)
MOCK_API=1
NEXT_PUBLIC_MOCK_API=1

# Server Next.js gọi API khi render trang công khai (ISR).
# Dev + mock: chính Next.js. Production: http://api:8000 (mạng Docker)
API_INTERNAL_URL=http://localhost:3000

# Để trống: trình duyệt gọi /api cùng domain (Caddy định tuyến)
NEXT_PUBLIC_API_URL=

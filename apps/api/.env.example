ENV=dev

# ---- Database, cách 1: PostgreSQL trong Docker (nhanh nhất khi dev)
DATABASE_URL=postgresql+asyncpg://mathgen:mathgen@localhost:5432/mathgen
DATABASE_SSL=false

# ---- Database, cách 2: Supabase — Dashboard → Connect → "Session pooler" (cổng 5432, có IPv4)
# Dán nguyên chuỗi postgresql://… (backend tự đổi driver và bỏ tham số kiểu ?pgbouncer=true). KHÔNG commit file .env.
# DATABASE_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<vùng>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# DATABASE_POOL_SIZE=5
# Nếu dùng "Transaction pooler" (cổng 6543) cho API: bật dòng dưới, và cho migration chạy qua cổng 5432
# DATABASE_PGBOUNCER=true
# MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<vùng>.pooler.supabase.com:5432/postgres

# ---- Redis (Supabase không có Redis: dev dùng Docker; production dùng Redis trên VPS hoặc Upstash)
REDIS_URL=redis://localhost:6379/0

# Production: chuỗi ngẫu nhiên dài, giữ bí mật (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-only-insecure-secret-change-me-in-prod
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Production phải là true (cookie chỉ gửi qua HTTPS)
COOKIE_SECURE=false
# true: task Celery chạy ngay trong tiến trình API (dev/test, không cần worker)
CELERY_EAGER=true

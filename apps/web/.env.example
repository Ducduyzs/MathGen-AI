# ---- Chế độ 1: mock API trong Next.js (không cần backend)
MOCK_API=1
NEXT_PUBLIC_MOCK_API=1
# Server Next.js gọi API khi render trang công khai (ISR): mock thì là chính Next.js
API_INTERNAL_URL=http://localhost:3000

# ---- Chế độ 2: backend FastAPI thật (apps/api, cổng 8000) — bỏ comment 4 dòng dưới, comment 3 dòng trên
# MOCK_API=0
# NEXT_PUBLIC_MOCK_API=0
# API_PROXY_URL=http://localhost:8000
# API_INTERNAL_URL=http://localhost:8000

# Để trống: trình duyệt gọi /api cùng domain (Next.js chuyển tiếp ở dev, Caddy định tuyến ở production)
NEXT_PUBLIC_API_URL=
